# ── GitHub authentication ──────────────────────────────────────────────────
# GITHUB_TOKEN is injected automatically at container startup by entrypoint.sh,
# which calls `gh auth token` using the ~/.config/gh directory mounted from the host.
# No manual token management needed — just make sure you ran `gh auth login` on the host.
#
# If you prefer to set a token explicitly (e.g. in CI), you can still do:
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Public endpoint security (REQUIRED on VPS) ─────────────────────────────
# Multi-client auth keys (recommended): comma-separated list.
# Example:
# API_KEYS=token_home_assistant,token_n8n,token_phone
#
# Each client can use its own token in:
#   Authorization: Bearer <token>
#   X-API-Key: <token>
API_KEYS=

# Backward-compatible single key (still supported)
# If both are set, API accepts any key from API_KEYS plus API_KEY.
API_KEY=change-this-to-a-long-random-secret

# Requests per minute per API key
RATE_LIMIT_RPM=60

# Keep /health public for external uptime checks (true/false)
PUBLIC_HEALTH=true

# Domain used by Caddy for automatic HTTPS certificates
# Example: api.example.com
DOMAIN=localhost

# ── API backend (choose one) ───────────────────────────────────────────────
# Option A: GitHub Models – FREE tier, no Copilot subscription needed
COPILOT_BASE_URL=https://models.inference.ai.azure.com

# Option B: GitHub Copilot API – requires an active Copilot subscription
# COPILOT_BASE_URL=https://api.githubcopilot.com

# ── Default model ─────────────────────────────────────────────────────────
# GitHub Models free tier options (cheapest first):
#   gpt-4o-mini          ← recommended default
#   gpt-4o
#   meta-llama-3.1-8b-instruct
#   meta-llama-3.1-70b-instruct
#   mistral-small
#   phi-4
#
# GitHub Copilot API options (subscription required):
#   gpt-4o-mini
#   gpt-4o
#   o1-mini
#   claude-sonnet-4-5
#
COPILOT_MODEL=gpt-4o-mini
