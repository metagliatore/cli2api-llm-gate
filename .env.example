# ── Provider Selection ──────────────────────────────────────────────────────
# Choose your default AI provider:
#   copilot      ← GitHub Copilot / GitHub Models via Azure AI inference
#   antigravity  ← Google Antigravity via local `agy` CLI session
PROVIDER=copilot

# ── Google Antigravity Configuration ──────────────────────────────────────────
# Uses credentials already authenticated on the host in ~/.gemini.
# Available models:
#   gemini-3.8-flash-high     ← default, fast, large context
#   gemini-3.8-flash-medium
#   gemini-3.8-flash-low
#   gemini-3.7-flash-high
#   gemini-3.1-pro-high       ← deep reasoning
#   claude-sonnet-4-6         ← top-tier coding & reasoning
#   claude-opus-4-6-thinking  ← thinking model
#   gpt-oss-120b-medium
ANTIGRAVITY_MODEL=gemini-3.8-flash-high

# Optional: Reasoning effort (low|medium|high|xhigh|max)
# ANTIGRAVITY_EFFORT=high

# Optional: Explicit path to `agy` binary if not in ~/.gemini/bin/agy
# AGY_PATH=/root/.gemini/bin/agy

# ── GitHub Copilot Configuration ──────────────────────────────────────────────
# GITHUB_TOKEN is injected automatically at container startup by entrypoint.sh,
# which calls `gh auth token` using ~/.config/gh mounted from the host.
# Or set explicitly:
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# API backend:
# GitHub Copilot API (default):
COPILOT_BASE_URL=https://api.githubcopilot.com

# Copilot default model:
# Free tier: gpt-4o-mini (default), gpt-4o, meta-llama-3.1-8b-instruct, phi-4
# Copilot sub: gpt-4o-mini, gpt-4o, o1-mini, claude-sonnet-4-5
COPILOT_MODEL=gpt-4o-mini

# ── Public Endpoint Security (REQUIRED on VPS) ─────────────────────────────
# Multi-client auth keys (recommended): comma-separated list.
# Example:
# API_KEYS=token_home_assistant,token_n8n,token_phone
#
# Each client can use its own token in:
#   Authorization: Bearer <token>
#   X-API-Key: <token>
API_KEYS=

# Backward-compatible single key (still supported)
# If both are set, API accepts any key from API_KEYS plus API_KEY.
API_KEY=change-this-to-a-long-random-secret

# Requests per minute per API key
RATE_LIMIT_RPM=60

# Keep /health public for external uptime checks (true/false)
PUBLIC_HEALTH=true

# Domain used by Caddy for automatic HTTPS certificates
DOMAIN=localhost
